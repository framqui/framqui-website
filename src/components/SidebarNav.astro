---
import { THEMES } from "../constants/ui.ts";
import { ROUTES } from "../constants/routes.ts";
import es from "../i18n/es.json";

const links = [
  { key: "bio", url: ROUTES.ABOUT },
  { key: "posts", url: ROUTES.POSTS },
  { key: "notes", url: ROUTES.NOTES },
] as const;

const controls = [
  {
    id: "lang-toggle",
    ariaKey: "a11y.toggleLang",
    aria: es.a11y.toggleLang,
    labelKey: "lang.current",
    default: es.lang.current,
  },
  {
    id: "theme-toggle",
    ariaKey: "a11y.toggleTheme",
    aria: es.a11y.toggleTheme,
    labelKey: "theme.light",
    default: es.theme.light,
  },
];

const currentPath = Astro.url.pathname.endsWith("/") && Astro.url.pathname.length > 1
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;
---

<!-- OVERLAY ON MOBILE -->
<div id="overlay" class="fixed inset-0 z-40 hidden bg-black/70 backdrop-blur-sm md:hidden"></div>

<!-- HEADER ON MOBILE -->
<header class="flex items-center justify-between py-4 px-6 md:hidden">
  <a href={ROUTES.HOME} class="whitespace-nowrap text-xl font-bold no-underline">
    <span class="text-[var(--accent)]">[</span>
    Framqui
    <span class="text-[var(--accent)]">]</span>
  </a>

  <button
      type="button"
      id="menu-open"
      data-i18n-aria="a11y.openMenu"
      aria-label={es.a11y.openMenu}
      aria-controls="sidebar-menu"
      class="text-xs text-[var(--muted)] hover:text-[var(--accent)] transition-colors duration-200 cursor-pointer bg-transparent border-none p-0"
  >
    <span class="text-[var(--fg)] font-bold px-1 text-xl leading-none">☰</span>
  </button>
</header>

<!-- SIDEBAR -->
<aside
    id="sidebar-menu"
    class="fixed top-0 bottom-0 left-0 z-50 flex w-64 -translate-x-full flex-col justify-between bg-[var(--bg)] p-6 pb-6 transition-transform duration-200 md:top-4 md:bottom-8 md:left-4 md:z-auto md:w-[160px] md:translate-x-0 md:bg-transparent md:p-0"
>
  <div>
    <!-- CLOSE BUTTON ON MOBILE -->
    <button
        type="button"
        id="menu-close"
        data-i18n-aria="a11y.closeMenu"
        aria-label={es.a11y.closeMenu}
        class="mb-6 ml-auto block text-xl text-[var(--muted)] hover:text-[var(--accent)] font-bold md:hidden"
    >
      <span class="text-[var(--fg)] font-bold text-xl">✕</span>
    </button>

    <!-- SIDEBAR HEADER -->
    <div class="mb-4 pt-2 hidden md:block">
      <a href={ROUTES.HOME} class="inline-block whitespace-nowrap text-xl font-bold no-underline text-[var(--fg)] tracking-tight group">
        <span class="text-[var(--accent)]">[</span>
        <span class="group-hover:underline decoration-[var(--accent)] decoration-2 underline-offset-4">Framqui</span>
        <span class="text-[var(--accent)]">]</span>
      </a>
    </div>

    <!-- NAVIGATION MENU -->
    <nav class="flex flex-col gap-2 font-mono">
      {links.map((link) => {
        const isActive = currentPath === link.url;
        return (
            <a
                href={link.url}
                data-i18n={`nav.${link.key}`}
                class:list={[
                  "text-xs tracking-widest transition-colors duration-200 no-underline hover:underline hover:decoration-[var(--accent)] hover:decoration-2 hover:underline-offset-4",
                  isActive ? "text-[var(--accent)] font-bold" : "text-[var(--fg)]"
                ]}
            >
              {es.nav[link.key]}
            </a>
        );
      })}
    </nav>
  </div>

  <!-- VISUAL SETTING CONTROL -->
  <div class="flex flex-col gap-2 text-xs font-mono">
    {controls.map((control) => (
        <button
            type="button"
            id={control.id}
            data-i18n-aria={control.ariaKey}
            aria-label={control.aria}
            class="text-left bg-transparent border-none cursor-pointer p-0 text-xs tracking-widest text-[var(--fg)] no-underline hover:underline transition-colors duration-200"
        >
          <span class="inline-block whitespace-nowrap">
            <span class="text-[var(--accent)] font-bold">[</span>
            <span
                id={`${control.id}-text`}
                data-i18n={control.labelKey}
                class="text-[var(--fg)] hover:underline decoration-[var(--accent)] decoration-2 underline-offset-2">
              {control.default}
            </span>
            <span class="text-[var(--accent)] font-bold">]</span>
          </span>
        </button>
    ))}
  </div>
</aside>

<script>
  import { THEMES } from "../constants/ui.ts";
  import { storage } from "../lib/storage.ts";
  import {
    applyLocale,
    isLocale,
    LANG_STORAGE_KEY,
    translate,
    DEFAULT_LOCALE,
    type Locale,
  } from "../i18n/index.ts";

  const THEME_KEY = "theme";

  function currentLocale(): Locale {
    return document.documentElement.lang === "en" ? "en" : DEFAULT_LOCALE;
  }

  function readLocale(): Locale {
    const stored = storage.get<string>(LANG_STORAGE_KEY, DEFAULT_LOCALE);
    return isLocale(stored) ? stored : DEFAULT_LOCALE;
  }

  function applyTheme(themeKey: string) {
    const isLight = themeKey === THEMES.light.key;
    document.documentElement.classList.toggle(THEMES.light.key, isLight);
    const themeText = document.getElementById("theme-toggle-text");
    if (!themeText) return;

    const labelKey = isLight ? "theme.light" : "theme.dark";
    themeText.dataset.i18n = labelKey;
    const label = translate(currentLocale(), labelKey);
    if (label) themeText.textContent = label;
  }

  function initHeader() {
    const sidebar = document.getElementById("sidebar-menu");
    const overlay = document.getElementById("overlay");

    const toggleMenu = (open: boolean) => {
      sidebar?.classList.toggle("-translate-x-full", !open);
      overlay?.classList.toggle("hidden", !open);
    };

    if (overlay) overlay.onclick = () => toggleMenu(false);

    const menuOpenBtn = document.getElementById("menu-open");
    const menuCloseBtn = document.getElementById("menu-close");

    if (menuOpenBtn) menuOpenBtn.onclick = () => toggleMenu(true);
    if (menuCloseBtn) menuCloseBtn.onclick = () => toggleMenu(false);

    // THEME TOGGLE
    const initialTheme = storage.getWithSystemFallback(
        THEME_KEY,
        THEMES.light.key,
        THEMES.dark.key
    );
    applyTheme(initialTheme);

    const themeButton = document.getElementById("theme-toggle");
    if (themeButton) {
      themeButton.onclick = () => {
        const isCurrentlyLight = document.documentElement.classList.contains(THEMES.light.key);
        const nextThemeKey = isCurrentlyLight ? THEMES.dark.key : THEMES.light.key;

        storage.set(THEME_KEY, nextThemeKey);
        applyTheme(nextThemeKey);
      };
    }

    const locale = readLocale();
    applyLocale(locale);

    // LANGUAGE TOGGLE
    const langButton = document.getElementById("lang-toggle");

    if (langButton) {
      langButton.onclick = () => {
        const nextLocale: Locale = currentLocale() === "es" ? "en" : "es";
        storage.set(LANG_STORAGE_KEY, nextLocale);
        applyLocale(nextLocale);
      };
    }
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>