---
import { Icon } from "astro-icon/components";
import { SOCIAL_LINKS } from "../constants/social.ts";
import es from "../i18n/es.json";
import { loadProfile, techIcons } from "../lib/profile.ts";

const { profile, stack } = await loadProfile();
const icons = techIcons(stack);
const facts = [
  { labelKey: "details.role", label: es.details.role, valueKey: "profile.role", value: profile.role.es, spaced: false },
  { labelKey: "details.experience", label: es.details.experience, valueKey: "profile.years", value: profile.years.es, spaced: true },
];
const coreTech = profile.core.map((entry) => ({
  name: entry.name,
  icons: entry.icons.map((id) => {
    const icon = icons.get(id);
    if (!icon) throw new Error(`No existe el icono de ${id}`);
    return icon;
  }),
}));
---

<aside
    class="mb-8 w-full text-left lg:order-2 lg:mb-0 lg:w-64 lg:shrink-0"
    data-i18n-aria="a11y.secondaryDetails"
    aria-label="Detalles secundarios"
>
  <div class="flex flex-col gap-6 lg:gap-8">
    <div class="flex items-center justify-between">
      <h2 class="font-mono text-md font-bold uppercase tracking-widest text-[var(--muted)]">
        <span data-i18n="details.title">DETALLES</span>
      </h2>
      <!-- COLLAPSIBLE ON MOBILE -->
      <button
          type="button"
          data-side-toggle="top"
          aria-expanded="false"
          aria-controls="side-list"
          data-i18n-aria="a11y.toggleDetails"
          aria-label="Mostrar u ocultar información"
          class="mr-2 cursor-pointer text-[var(--fg)] lg:hidden"
      >
        <svg data-icon-plus class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 12h16M12 4v16" />
        </svg>
        <svg data-icon-minus class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 12h16" />
        </svg>
      </button>
    </div>

    <div id="side-list" class="hidden lg:block">
      <div class="divide-y divide-[var(--muted)]/40 border-b border-[var(--muted)]/40">
        <section class="pb-6">
          <h3 class="font-mono text-xs mb-3 uppercase tracking-widest text-[var(--muted)]">
            <span data-i18n="details.networks">Redes y contacto</span>
          </h3>
          <div class="mt-0.5 font-sans text-sm text-[var(--fg)]">
            <ul class="flex flex-col items-start gap-3 font-mono text-xs uppercase tracking-widest">
              {SOCIAL_LINKS.map((link) => {
                const external = link.url.startsWith("http");
                return (
                    <li>
                      <a
                          href={link.url}
                          target={external ? "_blank" : undefined}
                          rel={external ? "noopener noreferrer" : undefined}
                          class="inline-flex items-center gap-1.5 border-b-2 border-transparent pb-1 text-[var(--fg)] no-underline hover:border-[var(--accent)]"
                      >
                        <Icon
                            name={link.icon}
                            class="h-4 w-4 shrink-0"
                            style={link.color ? `color: ${link.color}` : undefined}
                            aria-hidden="true"
                        />
                        {link.i18nKey ? <span data-i18n={link.i18nKey}>{link.name}</span> : link.name}
                      </a>
                    </li>
                );
              })}
            </ul>
          </div>
        </section>

        {facts.map((fact) => (
            <section class="py-6">
              <h3 class:list={["font-mono text-xs uppercase tracking-widest text-[var(--muted)]", fact.spaced && "mb-3"]}>
                <span data-i18n={fact.labelKey}>{fact.label}</span>
              </h3>
              <div data-i18n={fact.valueKey} class="mt-0.5 font-sans text-sm text-[var(--fg)]">
                {fact.value}
              </div>
            </section>
        ))}

        <section class="py-6">
          <h3 class="font-mono text-xs mb-3 uppercase tracking-widest text-[var(--muted)]">
            <span data-i18n="details.tech">{es.details.tech}</span>
          </h3>
          <ul class="space-y-2.5 font-sans text-sm text-[var(--fg)]">
            {coreTech.map(({ name, icons: tech }) => (
                <li class="flex items-center gap-2.5">
                  <span class="flex items-center gap-1.5">
                    {tech.map(({ icon, color }) => (
                        <Icon
                            name={icon}
                            class="h-4 w-4 shrink-0"
                            style={`color: ${color}`}
                            aria-hidden="true"
                        />
                    ))}
                  </span>
                  {name}
                </li>
            ))}
          </ul>
        </section>

        <section class="py-6">
          <h3 class="font-mono text-xs mb-3 uppercase tracking-widest text-[var(--muted)]">
            <span data-i18n="details.interests">{es.details.interests}</span>
          </h3>
          {profile.sidebarInterests.map((interest) => (
              <div data-i18n={`profile.sidebar.${interest.id}`} class="mt-0.5 font-sans text-sm text-[var(--fg)]">
                {interest.es}
              </div>
          ))}
        </section>

        <section class="py-6">
          <h3 class="font-mono text-xs mb-3 uppercase tracking-widest text-[var(--muted)]">
            <span data-i18n="details.location">{es.details.location}</span>
          </h3>
          <div data-i18n="profile.location" class="mt-0.5 font-sans text-sm text-[var(--fg)]">
            {profile.location.es}
          </div>
        </section>
      </div>

      <!-- CLOSE BOTTOM ON MOBILE -->
      <div class="mt-4 flex justify-end lg:hidden">
        <button
            type="button"
            data-side-toggle="bottom"
            aria-controls="side-list"
            data-i18n-aria="a11y.hideDetails"
            aria-label="Ocultar información"
            class="mr-2 cursor-pointer text-[var(--fg)]"
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 12h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  const list = document.getElementById('side-list');
  const topBtn = document.querySelector('[data-side-toggle="top"]');
  const iconPlus = topBtn?.querySelector('[data-icon-plus]');
  const iconMinus = topBtn?.querySelector('[data-icon-minus]');

  const setOpen = (open) => {
    list?.classList.toggle('hidden', !open);
    topBtn?.setAttribute('aria-expanded', String(open));
    iconPlus?.classList.toggle('hidden', open);
    iconMinus?.classList.toggle('hidden', !open);
  };

  document.querySelectorAll('[data-side-toggle]').forEach((btn) =>
      btn.addEventListener('click', () => setOpen(list?.classList.contains('hidden') ?? false))
  );
</script>