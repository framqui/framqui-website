---
import { SOCIAL_LINKS } from "../constants/social.ts";

const year = new Date().getFullYear();
---

<footer class="mt-12 px-6 py-7 font-mono text-xs uppercase tracking-[1px] text-[var(--muted)] md:px-8 md:text-sm">
  <div class="flex flex-col items-center justify-between gap-4 border-t border-[var(--line)] pt-6 sm:flex-row">
    <div>© {year} Andres Ramos</div>

    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <span data-i18n="footer.connect">CONECTA:</span>

      {SOCIAL_LINKS.map((link, index) => {
        const external = link.url.startsWith("http");
        return (
          <>
            <a
                href={link.url}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class="no-underline hover:underline hover:decoration-[var(--accent)] hover:decoration-2 hover:underline-offset-4 text-[var(--fg)]"
            >
              {link.i18nKey ? <span data-i18n={link.i18nKey}>{link.name}</span> : link.name}
            </a>
            {index < SOCIAL_LINKS.length - 1 && (
                <span class="text-[var(--muted)] select-none">|</span>
            )}
          </>
        );
      })}
    </div>
  </div>
</footer>
