---
const { href, label, activeKey } = Astro.props;
const activeItem = Astro.props.activeItem || 'inicio';
const isActive = activeItem === activeKey;
---

<a
  href={href}
  class:list={[
    'font-mono text-base no-underline',
    isActive ? 'font-bold text-ink' : 'text-muted hover:text-ink',
  ]}
  aria-current={isActive ? 'page' : undefined}
>
  {label}
</a>
