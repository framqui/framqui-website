---
export interface Props {
  title: string;
  intro?: string;
  note?: string;
  empty?: string;
  articles: Array<{
    slug: string;
    data: {
      title: string;
      date: string;
      description?: string;
      tags?: string[];
    };
  }>;
  basePath: string;
}

const { title, intro, note, empty, articles, basePath } = Astro.props;
---

<h1>{title}</h1>
{intro && <p class="mt-5 text-lg leading-relaxed">{intro}</p>}
{note && <p class="mt-5 text-sm leading-relaxed text-accent">{note}</p>}

{articles.length === 0 ? (
  empty && <p class="mt-10 text-lg text-muted">{empty}</p>
) : (
  <div class="article-grid">
    {articles.map((article) => (
      <a class="article-card" href={`${basePath}/${article.slug}`}>
        <div class="article-card-top">
          <h2>{article.data.title}</h2>
          <time>
            {new Date(article.data.date).toLocaleDateString('es-ES', {
              day: 'numeric',
              month: 'short',
              year: 'numeric',
            })}
          </time>
        </div>
        {article.data.description && <p>{article.data.description}</p>}
        {article.data.tags?.length > 0 && (
          <ul class="article-tags">
            {article.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </a>
    ))}
  </div>
)}
