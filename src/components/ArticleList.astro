---
export interface Props {
  title: string;
  intro?: string;
  note?: string;
  empty?: string;
  articles: Array<{
    slug: string;
    data: {
      title: string;
      date: string;
      description?: string;
      tags?: string[];
    };
  }>;
  basePath: string;
}

const { title, intro, note, empty, articles, basePath } = Astro.props;
---

<h1 class="text-4xl font-bold tracking-tight">{title}</h1>
{intro && <p class="mt-5 text-lg leading-relaxed">{intro}</p>}
{note && <p class="mt-5 text-sm leading-relaxed text-[#c45c26]">{note}</p>}

{articles.length === 0 ? (
  empty && <p class="mt-10 text-lg text-muted">{empty}</p>
) : (
  <div class="mt-12 divide-y divide-line border-t border-line pt-6">
    {articles.map((article) => (
      <article class="py-3">
        <div class="flex items-baseline justify-between gap-4">
          <a href={`${basePath}/${article.slug}`} class="truncate text-base font-semibold text-ink no-underline hover:text-accent">
            {article.data.title}
          </a>
          <time class="shrink-0 font-mono text-xs text-muted">
            {new Date(article.data.date).toLocaleDateString('es-ES', {
              day: 'numeric',
              month: 'short',
              year: 'numeric',
            })}
          </time>
        </div>
        {article.data.description && (
          <p class="mt-1 text-sm text-muted">{article.data.description}</p>
        )}
      </article>
    ))}
  </div>
)}
