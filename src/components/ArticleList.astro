---
export interface Props {
  title: string;
  intro?: string;
  note?: string;
  empty?: string;
  articles: Array<{
    slug: string;
    data: {
      title: string;
      date: string;
      description?: string;
      tags?: string[];
    };
  }>;
  basePath: string;
}

const { title, intro, note, empty, articles, basePath } = Astro.props;
---

<h1 class="text-4xl font-bold tracking-tight">{title}</h1>
{intro && <p class="mt-5 text-lg leading-relaxed">{intro}</p>}
{note && <p class="mt-5 text-sm leading-relaxed text-[#c45c26]">{note}</p>}

{articles.length === 0 ? (
  empty && <p class="mt-10 text-lg text-muted">{empty}</p>
) : (
  <div class="mt-10 divide-y divide-line border-y border-line">
    {articles.map((article) => (
      <article class="py-6">
        <a href={`${basePath}/${article.slug}`} class="text-2xl font-semibold text-ink no-underline hover:text-accent">
          {article.data.title}
        </a>
        <time class="mt-2 block font-mono text-xs text-muted">
          {new Date(article.data.date).toLocaleDateString('es-ES', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })}
        </time>
        {article.data.description && (
          <p class="mt-2 text-muted">{article.data.description}</p>
        )}
        {article.data.tags && article.data.tags.length > 0 && (
          <p class="mt-3 text-sm text-muted">{article.data.tags.join(' · ')}</p>
        )}
      </article>
    ))}
  </div>
)}
