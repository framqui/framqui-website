---
import MarkdownContent from './MarkdownContent.astro';

export interface Props {
  title: string;
  articles: Array<{
    slug: string;
    data: {
      title: string;
      date: string;
      description?: string;
      tags?: string[];
    };
  }>;
  basePath: string;
}

const { title, articles, basePath } = Astro.props;
---

<MarkdownContent>
  <h1 class="text-3xl font-semibold tracking-tight text-text-dark mt-10 mb-4">{title}</h1>

  <div class="space-y-6">
    {articles.map((article) => (
      <article class="space-y-1">
        <a
          href={`${basePath}/${article.slug}`}
          class="block text-xl font-semibold text-text-dark no-underline hover:text-blue hover:underline transition-colors"
        >
          {article.data.title}
        </a>

        <time class="text-xs text-text-muted font-mono">
          {new Date(article.data.date).toLocaleDateString('es-ES', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })}
        </time>

        {article.data.description && (
          <p class="text-xs text-text-muted font-mono">{article.data.description}</p>
        )}

        {article.data.tags && article.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {article.data.tags.map((tag) => (
              <span class="text-xs text-text-muted font-mono">#{tag}</span>
            ))}
          </div>
        )}

        <div class="w-full h-px bg-gray-200 mt-3" />
      </article>
    ))}
  </div>
</MarkdownContent>
