---
interface Props {
  title: string;
  date: string;
}

const { title, date } = Astro.props;
---

<article class="pt-[6rem] pb-15">
  <h1 class="text-center text-3xl md:text-4xl font-bold text-text-dark tracking-tight leading-[1.2] mb-15">
    {title}
  </h1>

  <time class="text-sm text-blue font-mono leading-[1.7]">{date}</time>
</article>
