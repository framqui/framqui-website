---
import { Icon } from "astro-icon/components";
import { SOCIAL_LINKS } from "../constants/social.ts";
import es from "../i18n/es.json";
import { loadProfile } from "../lib/profile.ts";
import PageHeader from "./PageHeader.astro";

const { profile, interests, experience, stack } = await loadProfile();
---

<div class="min-w-0 flex-1 lg:order-1">
  <PageHeader title="Andres Felipe Ramos Quintero" description={profile.role.es} descriptionKey="profile.role">
    <div class="mb-1 mt-5 lg:hidden">
      <div class="flex flex-wrap gap-x-2 gap-y-1 font-mono text-sm uppercase tracking-widest">
        {SOCIAL_LINKS.map((link, index) => {
          const external = link.url.startsWith("http");
          return (
              <>
                <a
                    href={link.url}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                    class="text-[var(--fg)] no-underline hover:underline hover:decoration-[var(--accent)] hover:underline-offset-4"
                >
                  {link.i18nKey ? <span data-i18n={link.i18nKey}>{link.name}</span> : link.name}
                </a>
                {index < SOCIAL_LINKS.length - 1 && (
                    <span class="select-none text-[var(--line)]" aria-hidden="true">/</span>
                )}
              </>
          );
        })}
      </div>
    </div>
  </PageHeader>

  <section class="sheet">
    <h2 data-i18n="profile.aboutTitle" class="sheet-title font-sans">
      {profile.aboutTitle.es}
    </h2>
    <div class="mt-6 grid grid-cols-1 items-start gap-6 md:grid-cols-[200px_minmax(0,1fr)] md:gap-10">
      <figure class="mx-auto w-[200px] text-center md:mx-0">
        <img
            src="/me.webp"
            alt={es.a11y.profilePhoto}
            data-i18n-alt="a11y.profilePhoto"
            width="400"
            height="532"
            loading="lazy"
            decoding="async"
            class="block w-full"
        />
        <figcaption data-i18n="profile.caption" class="mt-4 font-sans text-sm font-bold leading-snug text-[var(--fg)]">
          {profile.caption.es}
        </figcaption>
      </figure>
      <div class="flex max-w-3xl flex-col gap-4 font-sans text-[0.9375rem] leading-relaxed text-[var(--muted)]">
        {profile.bio.map((paragraph, index) => (
            paragraph.html
                ? <p data-i18n-html={`profile.bio.${index}`} set:html={paragraph.es} />
                : <p data-i18n={`profile.bio.${index}`}>{paragraph.es}</p>
        ))}
        <div>
          <h3 data-i18n="profile.siteTitle" class="font-sans text-sm font-semibold text-[var(--fg)]">
            {profile.siteTitle.es}
          </h3>
          <p class="mt-1.5" data-i18n-html="profile.siteBody" set:html={profile.siteBody.es} />
        </div>
      </div>
    </div>
  </section>

  <section class="sheet">
    <h2 data-i18n="profile.interestsTitle" class="sheet-title font-sans">
      {profile.interestsTitle.es}
    </h2>
    {interests.map((entry) => (
        <article class="row">
          <h3 data-i18n={`interests.${entry.id}.title`} class="row-label font-sans">
            {entry.data.title.es}
          </h3>
          <p data-i18n={`interests.${entry.id}.description`} class="row-body">
            {entry.data.description.es}
          </p>
        </article>
    ))}
  </section>

  <section class="sheet">
    <h2 data-i18n="profile.experienceTitle" class="sheet-title font-sans">
      {profile.experienceTitle.es}
    </h2>
    {experience.map((entry) => (
        <article class="row">
          <div>
            <h3 class="row-label font-sans">{entry.data.company}</h3>
            <p data-i18n={`experience.${entry.id}.period`} class="mt-1 font-mono text-xs tracking-wide text-[var(--fg)]">
              {entry.data.period.es}
            </p>
          </div>
          <div class="row-body">
            <p data-i18n={`experience.${entry.id}.role`} class="font-medium text-[var(--fg)]">
              {entry.data.role.es}
            </p>
            <p data-i18n={`experience.${entry.id}.description`} class="mt-3">
              {entry.data.description.es}
            </p>
            <h4 data-i18n={`experience.${entry.id}.sectionTitle`} class="mb-2 mt-4 font-sans text-sm font-semibold text-[var(--fg)]">
              {entry.data.sectionTitle.es}
            </h4>
            <ul class="list-disc space-y-1.5 pl-5">
              {entry.data.items.map((item) => (
                  <li data-i18n={`experience.${entry.id}.items.${item.id}`}>{item.es}</li>
              ))}
            </ul>
            <a
                href={entry.data.linkUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-i18n={`experience.${entry.id}.linkText`}
                class="mt-4 inline-block font-semibold text-[var(--accent)] no-underline hover:underline hover:underline-offset-4"
            >
              {entry.data.linkText.es}
            </a>
          </div>
        </article>
    ))}
  </section>

  <section class="sheet">
    <h2 data-i18n="profile.stackTitle" class="sheet-title font-sans">
      {profile.stackTitle.es}
    </h2>
    <p data-i18n="profile.stackIntro" class="row-body max-w-3xl py-4">
      {profile.stackIntro.es}
    </p>
    {stack.map((group) => (
        <div class="row">
          <h3 data-i18n={`techGroups.${group.id}`} class="row-label font-sans">
            {group.data.title.es}
          </h3>
          <ul class="flex flex-wrap gap-x-4 gap-y-2">
            {group.data.items.map((item) => (
                <li class="inline-flex items-center gap-1.5 font-sans text-sm text-[var(--fg)]">
                  <Icon
                      name={item.icon}
                      class="h-3.5 w-3.5 shrink-0 text-[var(--muted)]"
                      aria-hidden="true"
                  />
                  {typeof item.name === "string"
                      ? item.name
                      : <span data-i18n={`stackItems.${group.id}.${item.id}`}>{item.name.es}</span>}
                </li>
            ))}
          </ul>
        </div>
    ))}
  </section>
</div>
