---
import { Icon } from "astro-icon/components";
import { EXPERIENCES, INTEREST_KEYS, TECH_GROUPS } from "../constants/profile.ts";
import { SOCIAL_LINKS } from "../constants/social.ts";
import es from "../i18n/es.json";
---

<div class="min-w-0 flex-1 lg:order-1">
  <h1 class="font-sans text-4xl font-bold leading-[1.00] tracking-tight text-[var(--fg)] sm:text-5xl">
    Andres Felipe Ramos Quintero
  </h1>

  <p data-i18n="profile.role" class="mt-4 max-w-xl font-sans text-lg leading-relaxed text-[var(--muted)]">
    {es.profile.role}
  </p>

  <!-- SECTION FOR VISIBLE NETWORKS ON MOBILE -->
  <div class="lg:hidden mb-4">
    <div class="flex flex-wrap gap-x-2 font-mono text-sm uppercase tracking-widest">
      {SOCIAL_LINKS.map((link, index) => {
        const external = link.url.startsWith("http");
        return (
            <>
              <a
                  href={link.url}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class="no-underline hover:underline hover:decoration-[var(--accent)] hover:decoration-2 hover:underline-offset-4 text-[var(--fg)] font-mono"
              >
                {link.i18nKey ? <span data-i18n={link.i18nKey}>{link.name}</span> : link.name}
              </a>
              {index < SOCIAL_LINKS.length - 1 && (
                  <span class="text-[var(--muted)] select-none font-mono">|</span>
              )}
            </>
        );
      })}
    </div>
  </div>

  <hr class="mt-6 w-full border-t-2 border-[var(--accent)]" />

  <!-- ABOUT ME -->
  <div class="mt-10 mb-10">
    <h2 data-i18n="profile.aboutTitle" class="font-sans text-3xl font-bold tracking-tight text-[var(--fg)] sm:text-4xl">
      {es.profile.aboutTitle}
    </h2>
    <hr class="mt-2 w-full border-t border-[var(--muted)]/30" />
  </div>

  <div class="grid grid-cols-1 items-start gap-8 xl:grid-cols-[220px_minmax(0,1fr)] xl:gap-12 2xl:grid-cols-[260px_minmax(0,1fr)]">
    <figure class="flex flex-col items-center text-center">
      <div class="w-40 overflow-hidden rounded-sm border border-[var(--muted)]/20 sm:w-48 xl:w-full max-w-[200px]">
        <img
            src="/me.webp"
            alt="Andres Ramos"
            width="400"
            height="532"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
        />
      </div>
      <figcaption data-i18n="profile.caption" class="mt-4 max-w-[200px] font-sans text-sm font-bold leading-relaxed text-[var(--fg)]">
        {es.profile.caption}
      </figcaption>
    </figure>

    <div class="flex max-w-3xl flex-col gap-7 font-sans text-sm leading-relaxed text-[var(--muted)]">
      <div class="flex flex-col gap-4">
        <p class="font-sans" data-i18n-html="profile.bio1" set:html={es.profile.bio1} />
        <p class="font-sans" data-i18n-html="profile.bio2" set:html={es.profile.bio2} />
        <p class="font-sans" data-i18n="profile.bio3">{es.profile.bio3}</p>
      </div>

      <div>
        <h3 data-i18n="profile.siteTitle" class="font-sans text-sm font-bold text-[var(--fg)]">
          {es.profile.siteTitle}
        </h3>
        <p class="mt-2 font-sans" data-i18n-html="profile.siteBody" set:html={es.profile.siteBody} />
      </div>
    </div>
  </div>

  <!-- INTERESTS SECTION -->
  <div class="mt-10 mb-10">
    <h2 data-i18n="profile.interestsTitle" class="font-sans text-3xl font-bold tracking-tight text-[var(--fg)] sm:text-4xl">
      {es.profile.interestsTitle}
    </h2>
    <hr class="mt-2 w-full border-t border-[var(--muted)]/30" />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-stretch">
    {INTEREST_KEYS.map((key) => (
        <div class="flex flex-col rounded-sm border border-[var(--muted)]/20 bg-transparent p-5">
          <h3 data-i18n={`interests.${key}.title`} class="mb-3 font-sans text-lg font-bold text-[var(--fg)]">
            {es.interests[key].title}
          </h3>
          <p data-i18n={`interests.${key}.description`} class="font-sans text-sm leading-relaxed text-[var(--muted)]">
            {es.interests[key].description}
          </p>
        </div>
    ))}
  </div>

  <!-- EXPERIENCE SECTION -->
  <div class="mt-10 mb-10">
    <h2 data-i18n="profile.experienceTitle" class="font-sans text-3xl font-bold tracking-tight text-[var(--fg)] sm:text-4xl">
      {es.profile.experienceTitle}
    </h2>
    <hr class="mt-2 w-full border-t border-[var(--muted)]/30" />
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
    {EXPERIENCES.map((exp) => {
      const copy = es.experience[exp.id];
      return (
        <div class="flex flex-col gap-4 rounded-sm border border-[var(--muted)]/20 bg-transparent p-6 font-sans">
          <div>
            <h3 class="font-sans text-lg font-bold text-[var(--fg)]">
              {exp.company}
            </h3>
            <p data-i18n={`experience.${exp.id}.role`} class="mt-1 font-sans text-sm text-[var(--muted)]">
              {copy.role}
            </p>
          </div>

          <p data-i18n={`experience.${exp.id}.description`} class="font-sans text-sm leading-relaxed text-[var(--muted)]">
            {copy.description}
          </p>

          <div>
            <h4 data-i18n={`experience.${exp.id}.sectionTitle`} class="mb-2 font-sans text-sm font-bold text-[var(--fg)]">
              {copy.sectionTitle}
            </h4>
            <ul class="font-sans list-inside list-disc space-y-1.5 text-sm leading-relaxed text-[var(--muted)]">
              {Object.entries(copy.items).map(([itemKey, item]) => (
                  <li data-i18n={`experience.${exp.id}.items.${itemKey}`} class="font-sans">{item}</li>
              ))}
            </ul>
          </div>

          <div class="mt-2 border-t border-[var(--muted)]/15 pt-4">
            <a
                href={exp.linkUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-i18n={`experience.${exp.id}.linkText`}
                class="font-sans text-sm font-bold text-[var(--fg)] no-underline hover:underline hover:decoration-[var(--accent)] hover:underline-offset-4"
            >
              {copy.linkText}
            </a>
          </div>
        </div>
      );
    })}
  </div>

  <!-- TECH STACK SECTION -->
  <div class="mt-10 mb-10">
    <h2 data-i18n="profile.stackTitle" class="font-sans text-3xl font-bold tracking-tight text-[var(--fg)] sm:text-4xl">
      {es.profile.stackTitle}
    </h2>
    <hr class="mt-2 w-full border-t border-[var(--muted)]/30" />
  </div>

  <p data-i18n="profile.stackIntro" class="mb-8 font-sans text-sm leading-relaxed text-[var(--muted)]">
    {es.profile.stackIntro}
  </p>

  <div class="flex flex-col gap-6 font-sans">
    {TECH_GROUPS.map((group) => (
        <div>
          <h3 data-i18n={`techGroups.${group.key}`} class="mb-3 font-sans text-sm font-bold text-[var(--fg)]">
            {group.title}
          </h3>
          <ul class="flex flex-wrap gap-2 font-sans">
            {group.items.map(({ name, icon, color }) => (
                <li class="inline-flex items-center gap-2 rounded-sm border border-[var(--muted)]/20 px-3 py-1.5 font-sans text-sm text-[var(--fg)]">
                  <Icon
                      name={icon}
                      class="h-4 w-4 shrink-0"
                      style={color ? `color: ${color}` : undefined}
                      aria-hidden="true"
                  />
                  {name}
                </li>
            ))}
          </ul>
        </div>
    ))}
  </div>
</div>