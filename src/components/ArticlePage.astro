---
import MarkdownContent from './MarkdownContent.astro';

export interface Props {
  htmlContent: string;
  backPath: string;
  showComments?: boolean;
}

const { htmlContent, backPath, showComments = false } = Astro.props;
const titleMatch = htmlContent.match(/^<h1\b[^>]*>[\s\S]*?<\/h1>/);
const titleHtml = titleMatch?.[0] ?? '';
const bodyHtml = titleMatch ? htmlContent.slice(titleMatch[0].length) : htmlContent;
---

{titleHtml && <div class="prose article-title" set:html={titleHtml} />}
<a class="article-back" href={backPath}>← Volver</a>

<div class="mt-8">
  <MarkdownContent htmlContent={bodyHtml} />
</div>

{showComments && (
  <section class="mt-16 border-t border-line pt-8">
    <h2>Comentarios</h2>
    <p class="mt-3 text-sm leading-relaxed text-muted">
      Hace falta una cuenta de GitHub. Quédate en el tema. Lo ofensivo o el spam se elimina.
      Más detalle en <a href="/politicas" class="underline underline-offset-4">privacidad</a>.
    </p>
    <div class="mt-6">
      <script
        src="https://giscus.app/client.js"
        data-repo="framqui/framqui-website"
        data-repo-id="R_kgDOVug6CA"
        data-category="General"
        data-category-id="DIC_kwDOVug6CM4DLO_O"
        data-mapping="title"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="dark"
        data-lang="es"
        crossorigin="anonymous"
        loading="lazy"
      ></script>
    </div>
  </section>
)}
