---
import MarkdownContent from './MarkdownContent.astro';

export interface Props {
  htmlContent: string;
  backPath: string;
  showComments?: boolean;
}

const { htmlContent, backPath, showComments = false } = Astro.props;
---

<div class="text-left py-4 mb-6">
  <a
    href={backPath}
    class="font-mono font-bold text-base text-text-muted no-underline cursor-pointer hover:text-blue hover:underline transition-colors"
  >
    ← volver
  </a>
</div>

<MarkdownContent htmlContent={htmlContent} />

{showComments && (
  <div class="mt-16 pt-8 border-t border-gray-200">
    <h3 class="font-mono font-bold text-base text-text-dark mb-6">Comentarios</h3>
    <p class="text-xs font-mono font-bold text-orange-600 mb-6">
      Para comentar necesitas una cuenta de GitHub. Comenta con moderación y manteniéndote en el tema del artículo. Los comentarios ofensivos, spam o fuera de contexto serán eliminados. Para más información, lee nuestras <a href="/politicas" class="underline hover:text-orange-700">políticas de privacidad</a>. Para eliminar tu propio comentario, dirígete a <a href="https://github.com/framqui/framqui-website/discussions" class="underline hover:text-orange-700" target="_blank">GitHub Discussions</a> y búscalo en Framqui.
    </p>
    <script
      src="https://giscus.app/client.js"
      data-repo="framqui/framqui-website"
      data-repo-id="R_kgDOVug6CA"
      data-category="General"
      data-category-id="DIC_kwDOVug6CM4DLO_O"
      data-mapping="title"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="light"
      data-lang="es"
      crossorigin="anonymous"
      loading="lazy"
    ></script>
  </div>
)}
