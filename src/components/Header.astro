---
import NavLink from './NavLink.astro';

const activeItem = Astro.props.active || 'inicio';

const links = [
  { href: '/', label: 'Inicio', activeKey: 'inicio' },
  { href: '/posts', label: 'Escritos', activeKey: 'posts' },
  { href: '/practices', label: 'Prácticas', activeKey: 'practices' },
];

const more = [
  { href: '/suscribite', label: 'Suscríbete', activeKey: 'suscribite' },
  { href: '/contactame', label: 'Contáctame', activeKey: 'contactame' },
  { href: '/framqui', label: 'Framqui', activeKey: 'framqui' },
  { href: '/politicas', label: 'Políticas', activeKey: 'politicas' },
];

const moreActive = more.some((item) => item.activeKey === activeItem);
---

<header class="site-header">
  <nav class="site-nav" aria-label="Principal">
    {links.map((link) => (
      <NavLink href={link.href} label={link.label} activeKey={link.activeKey} activeItem={activeItem} />
    ))}

    <div class:list={['more', moreActive && 'is-active']}>
      <button type="button" class="more-toggle" aria-expanded="false">Más</button>
      <div class="more-menu">
        {more.map((item) => (
          <NavLink href={item.href} label={item.label} activeKey={item.activeKey} activeItem={activeItem} />
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector('.more-toggle');
  const menu = document.querySelector('.more-menu');

  toggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = menu?.classList.toggle('show');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  document.addEventListener('click', () => {
    menu?.classList.remove('show');
    toggle?.setAttribute('aria-expanded', 'false');
  });
</script>
