---
import NavLink from './NavLink.astro';

const activeItem = Astro.props.active || 'inicio';

const dropdownItems = [
  { href: '#suscribete', label: 'SUSCRÍBETE' },
  { href: '#contacto', label: 'CONTACTAME' },
  { href: '#politicas', label: 'POLÍTICAS' },
  { href: '#framqui', label: 'FRAMQUI' },
];
---

<nav class="flex flex-wrap items-center justify-center gap-10 sm:gap-10 py-4 border-b border-gray-400">
  <NavLink href="/" label="INICIO" activeKey="inicio" activeItem={activeItem} />
  <NavLink href="/posts" label="ESCRITOS" activeKey="posts" activeItem={activeItem} />
  <NavLink href="/practices" label="PRÁCTICAS" activeKey="practices" activeItem={activeItem} />

  <div class="relative inline-block">
    <button class="dropdown-toggle font-mono font-bold text-sm text-text-dark bg-transparent border-none cursor-pointer tracking-tight transition-colors duration-200 p-0 inline-flex items-center gap-1 hover:text-blue hover:underline hover:underline-offset-4 sm:text-base">
      MÁS <span class="text-xs leading-none select-none">▾</span>
    </button>
    <div class="dropdown-menu hidden absolute top-full left-1/2 -translate-x-1/2 flex-col gap-2 py-2 px-6 mt-1 bg-bg border border-gray-200 min-w-[120px] z-10">
      {dropdownItems.map((item) => (
        <a href={item.href} class="font-mono font-bold text-sm text-text-dark no-underline tracking-tight whitespace-nowrap transition-colors duration-200 hover:text-blue hover:underline hover:underline-offset-4 sm:text-base">{item.label}</a>
      ))}
    </div>
  </div>
</nav>

<style>
  .dropdown-menu.show {
    display: flex;
  }

  @media (max-width: 640px) {
    .nav > :where(*) {
      font-size: 0.75rem !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.querySelector('.dropdown-toggle');
    const menu = document.querySelector('.dropdown-menu');

    toggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      menu?.classList.toggle('show');
    });

    document.addEventListener('click', () => {
      menu?.classList.remove('show');
    });
  });
</script>
