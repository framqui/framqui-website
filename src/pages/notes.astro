---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import UnderConstruction from '../components/UnderConstruction.astro';
import es from "../i18n/es.json";
---
<BaseLayout
  title={es.meta.notes.title}
  description={es.meta.notes.description}
  titleKey="meta.notes.title"
  descriptionKey="meta.notes.description"
>
  <div class="min-w-0 flex-1">
    <PageHeader
        title={es.pages.notesTitle}
        description={es.meta.notes.description}
        titleKey="pages.notesTitle"
        descriptionKey="meta.notes.description"
    />
    <UnderConstruction />
  </div>
</BaseLayout>