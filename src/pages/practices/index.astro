---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';

const practicesGlob = import.meta.glob('../../content/practices/*.md', { eager: true });
const articles = Object.entries(practicesGlob).map(([path, mod]) => {
  const slug = path.split('/').pop()?.replace('.md', '') || '';
  return { slug, data: mod.frontmatter || {}, body: typeof mod.rawContent === 'function' ? mod.rawContent() : '' };
}).sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<BaseLayout active="practices" title="Prácticas - Framqui" description="Prácticas y proyectos de automatización, scripts y DevOps.">
  <ArticleList
    title="Prácticas"
    articles={articles}
    basePath="/practices"
  />
</BaseLayout>
