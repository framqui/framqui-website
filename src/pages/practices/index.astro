---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { readMarkdown } from '../../lib/markdown.js';

const practicesGlob = import.meta.glob('../../content/practices/*.md', { eager: true, query: '?raw', import: 'default' });
const articles = Object.entries(practicesGlob).map(([path, raw]) => readMarkdown(path, raw)).sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<BaseLayout active="practices" title="Ejercicios - Framqui" description="Ejercicios y proyectos de automatización, scripts y DevOps.">
  <ArticleList
    title="Ejercicios"
    articles={articles}
    basePath="/practices"
  />
</BaseLayout>
