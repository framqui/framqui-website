---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import { marked } from 'marked';

export const prerender = true;

export async function getStaticPaths() {
  const practicesGlob = import.meta.glob('../../content/practices/*.md', { eager: true });

  return Object.entries(practicesGlob).map(([filePath, mod]) => {
    const slug = filePath.split('/').pop()?.replace('.md', '') || '';
    return {
      params: { slug },
      props: {
        practice: {
          data: mod.frontmatter || {},
          body: typeof mod.rawContent === 'function' ? mod.rawContent() : '',
        },
      },
    };
  });
}

const { practice } = Astro.props;
const htmlContent = marked.parse(practice.body, { gfm: true });
---

<BaseLayout active="practices" title={`${practice.data.title} - Prácticas - Framqui`} description={practice.data.description || 'Prácticas y proyectos de automatización, scripts y DevOps.'}>
  <ArticlePage htmlContent={htmlContent} backPath="/practices" />
</BaseLayout>
