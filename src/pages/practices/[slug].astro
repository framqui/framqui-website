---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import { readMarkdown } from '../../lib/markdown.js';
import { marked } from 'marked';

export const prerender = true;

export async function getStaticPaths() {
  const practicesGlob = import.meta.glob('../../content/practices/*.md', { eager: true, query: '?raw', import: 'default' });

  return Object.entries(practicesGlob).map(([filePath, raw]) => {
    const practice = readMarkdown(filePath, raw);
    return {
      params: { slug: practice.slug },
      props: { practice },
    };
  });
}

const { practice } = Astro.props;
const htmlContent = marked.parse(practice.body, { gfm: true });
---

<BaseLayout active="practices" title={`${practice.data.title} - Ejercicios - Framqui`} description={practice.data.description || 'Ejercicios y proyectos de automatización, scripts y DevOps.'}>
  <ArticlePage htmlContent={htmlContent} backPath="/practices" />
</BaseLayout>
