---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarkdownContent from '../components/MarkdownContent.astro';
import { marked } from 'marked';

const md = `# Suscríbete

Recibe un aviso cuando haya una publicación nueva o un cambio relevante en el sitio.`;
const htmlContent = marked.parse(md, { gfm: true });

const url = new URL(Astro.url);
const status = url.searchParams.get('status');
const unsub = url.searchParams.get('unsub');

const messages = {
  success: 'Para confirmar, revisa tu bandeja de entrada o la carpeta de spam.',
  already: 'Ya estás suscrito.',
  resend: 'Reenvié el enlace. Para confirmar, revisa tu bandeja de entrada o la carpeta de spam.',
  error: 'Error al enviar el correo. Intenta de nuevo.',
};

const unsubMessages = {
  success: 'Listo. Revisa tu bandeja o el spam: te envié el correo de confirmación.',
  notfound: 'El correo no está suscrito.',
  invalid: 'Correo inválido.',
  error: 'Error al desuscribir. Intenta de nuevo.',
};
---

<BaseLayout active="suscribite" title="Suscríbete - Framqui" description="Suscríbete para recibir notificaciones cuando se publique un nuevo artículo o práctica.">
  <MarkdownContent htmlContent={htmlContent} />
  <p class="mt-8 text-sm leading-relaxed text-[#c45c26]">
    Estos datos solo se utilizan para las notificaciones del sitio y para lo relacionado con ellas. No se usan para spam ni para otros fines. Más información en las <a href="/politicas" class="underline underline-offset-4 hover:text-[#9a4316]">políticas de privacidad</a>.
  </p>

  <form action="/api/subscribe" method="POST" class="mt-4 flex flex-col gap-3 sm:flex-row">
    <input name="email" type="email" placeholder="tu@correo.com" required class="field" />
    <button type="submit" class="btn">Suscríbete</button>
  </form>
  {status && messages[status] && (
    <p class:list={['notice mt-3', status === 'error' && 'notice-bad']}>{messages[status]}</p>
  )}

  <section class="mt-12 border-t border-line pt-8">
    <p class="text-sm text-muted">¿Ya no quieres recibir notificaciones? Ingresa tu correo para desuscribirte.</p>
    <form action="/api/unsubscribe" method="POST" class="mt-3 flex flex-col gap-3 sm:flex-row">
      <input name="email" type="email" placeholder="tu@correo.com" required class="field" />
      <button type="submit" class="btn">Desuscribirme</button>
    </form>
    {unsub && unsubMessages[unsub] && (
      <p class:list={['notice mt-3', unsub !== 'success' && 'notice-bad']}>{unsubMessages[unsub]}</p>
    )}
  </section>
</BaseLayout>
