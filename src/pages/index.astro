---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarkdownContent from '../components/MarkdownContent.astro';
import { marked } from 'marked';

const readmeUrl = 'https://raw.githubusercontent.com/framqui/framqui/main/README.md';
const profileMd = await fetch(readmeUrl).then((res) => res.text());
const htmlContent = marked.parse(profileMd, { gfm: true });
---

<BaseLayout active="inicio">
  <MarkdownContent htmlContent={htmlContent} />
</BaseLayout>
