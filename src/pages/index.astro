---
import BaseLayout from '../layouts/BaseLayout.astro';
import SidebarNav from '../components/SidebarNav.astro';
import Footer from "../components/Footer.astro";

const socialLinks = [
  { name: "GITHUB", url: "https://github.com/framqui", icon: `<svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>` },
  { name: "LINKEDIN", url: "https://linkedin.com/in/framqui", icon: `<svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>` },
  { name: "CORREO", url: "mailto:andfera201@gmail.com", icon: `<svg class="w-4 h-4 stroke-current fill-none stroke-2 shrink-0" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>` },
  { name: "WHATSAPP", url: "https://wa.me/3172116762", icon: `<svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>` }
];
---

<BaseLayout>
  <SidebarNav />

  <div class="min-h-screen flex flex-col">
    <div class="min-w-0 flex-1 flex flex-col md:ml-[110px]">
      <main class="px-6 pt-4 md:pt-6 md:px-8 lg:flex lg:gap-12">

        <!-- SECOND SECTION -->
        <aside
            class="mb-8 w-full text-left lg:order-2 lg:mb-0 lg:w-64 lg:shrink-0"
            aria-label="Detalles adicionales"
        >
          <div class="flex flex-col gap-6 lg:gap-8">
            <div class="flex items-center justify-between">
              <h2 class="font-mono text-md font-bold uppercase tracking-widest text-[var(--muted)]">
                DETALLES
              </h2>

              <!-- COLLAPSIBLE ON MOBILE -->
              <button
                  type="button"
                  data-side-toggle="top"
                  aria-expanded="false"
                  aria-controls="side-list"
                  aria-label="Mostrar u ocultar información"
                  class="mr-2 cursor-pointer text-[var(--fg)] lg:hidden"
              >
                <svg data-icon-plus class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 12h16M12 4v16" />
                </svg>
                <svg data-icon-minus class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 12h16" />
                </svg>
              </button>
            </div>

            <!-- REDES VISIBLES SIEMPRE EN MÓVIL (DEBAJO DE LA CABECERA DETALLES) -->
            <div class="lg:hidden">
              <ul class="flex flex-wrap items-center gap-x-5 gap-y-3 font-mono text-xs uppercase tracking-widest">
                {socialLinks.map((link) => {
                  const external = link.url.startsWith("http");
                  return (
                      <li>
                        <a
                            href={link.url}
                            target={external ? "_blank" : undefined}
                            rel={external ? "noopener noreferrer" : undefined}
                            class="inline-flex items-center gap-1.5 border-b-2 border-transparent pb-1 text-[var(--fg)] no-underline hover:border-[var(--accent)]"
                        >
                          <span class="text-[var(--accent)] font-bold">[</span>
                          <span class="inline-flex items-center gap-2 px-0.5">
                          <Fragment set:html={link.icon} />
                          <span>{link.name}</span>
                        </span>
                          <span class="text-[var(--accent)] font-bold">]</span>
                        </a>
                      </li>
                  );
                })}
              </ul>
            </div>

            <div id="side-list" class="hidden lg:block space-y-6">
              <!-- REDES Y CONTACTO -->
              <section>
                <h3 class="font-mono text-[10px] uppercase tracking-widest text-[var(--muted)]">
                  Redes y contacto
                </h3>
                <ul class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-3 font-mono text-xs uppercase tracking-widest lg:flex-col lg:items-start">
                  {socialLinks.map((link) => {
                    const external = link.url.startsWith("http");
                    return (
                        <li>
                          <a
                              href={link.url}
                              target={external ? "_blank" : undefined}
                              rel={external ? "noopener noreferrer" : undefined}
                              class="inline-flex items-center gap-1.5 border-b-2 border-transparent pb-1 text-[var(--fg)] no-underline hover:border-[var(--accent)]"
                          >
                            <span class="text-[var(--accent)] font-bold">[</span>
                            <span class="inline-flex items-center gap-2 px-0.5">
                            <Fragment set:html={link.icon} />
                            <span>{link.name}</span>
                          </span>
                            <span class="text-[var(--accent)] font-bold">]</span>
                          </a>
                        </li>
                    );
                  })}
                </ul>
              </section>

              <!-- UBICACIÓN, EXPERIENCIA Y ROL CON SEPARADORES -->
              <section class="border-t border-[var(--muted)]/20 pt-6 space-y-4">
                <div>
                  <dt class="font-mono text-[10px] uppercase tracking-widest text-[var(--muted)]">Ubicación</dt>
                  <dd class="mt-0.5 font-sans text-sm text-[var(--fg)]">Pitalito, Huila, Colombia</dd>
                </div>

                <hr class="border-t border-[var(--muted)]/15" />

                <div>
                  <dt class="font-mono text-[10px] uppercase tracking-widest text-[var(--muted)]">Experiencia</dt>
                  <dd class="mt-0.5 font-sans text-sm text-[var(--fg)]">Más de 5 años</dd>
                </div>

                <hr class="border-t border-[var(--muted)]/15" />

                <div>
                  <dt class="font-mono text-[10px] uppercase tracking-widest text-[var(--muted)]">Rol</dt>
                  <dd class="mt-0.5 font-sans text-sm text-[var(--fg)]">Desarrollador de software · Mid level</dd>
                </div>
              </section>

              <!-- Botón inferior para cerrar en móvil -->
              <div class="mt-4 flex justify-end lg:hidden">
                <button
                    type="button"
                    data-side-toggle="bottom"
                    aria-controls="side-list"
                    aria-label="Ocultar información"
                    class="mr-2 cursor-pointer text-[var(--fg)]"
                >
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 12h16" />
                  </svg>
                </button>
              </div>

            </div>

          </div>
        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="min-w-0 flex-1 lg:order-1">
          <p class="mb-6 font-mono text-xs uppercase tracking-widest text-[var(--muted)]">
            BIOGRAFÍA / ANDRES RAMOS
          </p>

          <h1 class="font-sans text-4xl font-bold leading-[0.95] tracking-tight text-[var(--fg)] sm:text-6xl">
            Andres Ramos
          </h1>

          <p class="mt-4 max-w-2xl font-sans text-lg leading-relaxed text-[var(--muted)] sm:text-xl md:text-2xl">
            Desarrollador de software mid level
          </p>

          <hr class="mt-6 w-full border-t-2 border-[var(--accent)]" />

          <!-- SOBRE MÍ CON SEPARADOR -->
          <div class="mt-8 mb-8">
            <h2 class="font-sans text-2xl font-bold tracking-tight text-[var(--fg)] sm:text-3xl">
              Sobre mí
            </h2>
            <hr class="mt-4 w-full border-t border-[var(--muted)]/30" />
          </div>

          <div class="grid grid-cols-1 items-start gap-8 xl:grid-cols-[220px_minmax(0,1fr)] xl:gap-12 2xl:grid-cols-[260px_minmax(0,1fr)]">

            <!-- FOTO Y FRASE CENTRADAS -->
            <figure class="flex flex-col items-center text-center">
              <div class="w-40 overflow-hidden rounded-sm border border-[var(--muted)]/20 sm:w-48 xl:w-full max-w-[200px]">
                <img
                    src="/images/me.png"
                    alt="Andres Ramos"
                    decoding="async"
                    class="block h-auto w-full"
                />
              </div>
              <figcaption class="mt-3 max-w-[200px] font-mono text-xs font-bold uppercase leading-relaxed tracking-wider text-[var(--fg)]">
                Transformando el desarrollo de software con inteligencia artificial
              </figcaption>
            </figure>

            <!-- TEXTO DE PRESENTACIÓN Y ESTE SITIO CON ENFOQUE DEBAJO -->
            <div class="flex max-w-3xl flex-col gap-7 font-sans text-sm leading-relaxed text-[var(--muted)] sm:text-base">

              <div class="flex flex-col gap-4">
                <p class="text-[var(--fg)]">
                  Hola, soy <strong class="font-semibold">Andres Ramos</strong> (conocido como <strong class="font-semibold">Ramos</strong>), desarrollador de software con más de <strong class="font-semibold">5 años de experiencia</strong>.
                </p>
                <p>
                  Nací en un pueblo muy pequeño llamado Gallardo, Huila, rodeado de campesinos, y actualmente vivo en Pitalito, Huila. Me apasiona resolver retos complejos y estructurar código robusto. Fuera de la tecnología, disfruto levantar pesas, escuchar música, leer e investigar sobre temas que despiertan mi curiosidad.
                </p>
              </div>

              <div>
                <h3 class="font-mono text-[10px] uppercase tracking-widest text-[var(--muted)]">
                  Este sitio
                </h3>
                <p class="mt-2">
                  Esta página funciona como mi bitácora pública y espacio personal. Aquí iré compartiendo notas técnicas, reflexiones sobre desarrollo de productos, materiales de estudio, guías, cursos, imágenes y proyectos en los que me encuentre trabajando. Es un entorno vivo que se irá actualizando según mi evolución profesional y personal.
                </p>

                <!-- ENFOQUE DEBAJO DE "ESTE SITIO" CON SEPARADORES / -->
                <div class="mt-4 pt-4 border-t border-[var(--muted)]/15 font-mono text-xs uppercase tracking-wider text-[var(--fg)] font-semibold flex flex-wrap items-center gap-x-2 gap-y-1">
                  <span>Desarrollo de software</span>
                  <span class="text-[var(--muted)]">/</span>
                  <span>Creación de productos digitales</span>
                  <span class="text-[var(--muted)]">/</span>
                  <span>Inteligencia artificial</span>
                </div>
              </div>

            </div>

          </div>

          <!-- LÍNEA SEPARADORA FINAL -->
          <hr class="mt-12 mb-6 w-full border-t border-[var(--muted)]/30" />

        </div>

      </main>

      <Footer />

    </div>
  </div>
</BaseLayout>

<script>
  const list = document.getElementById('side-list');
  const topBtn = document.querySelector<HTMLButtonElement>('[data-side-toggle="top"]');
  const iconPlus = topBtn?.querySelector('[data-icon-plus]');
  const iconMinus = topBtn?.querySelector('[data-icon-minus]');

  const setOpen = (open: boolean) => {
    list?.classList.toggle('hidden', !open);
    topBtn?.setAttribute('aria-expanded', String(open));
    iconPlus?.classList.toggle('hidden', open);
    iconMinus?.classList.toggle('hidden', !open);
  };

  document.querySelectorAll('[data-side-toggle]').forEach((btn) =>
      btn.addEventListener('click', () => setOpen(list?.classList.contains('hidden') ?? false))
  );
</script>