---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarkdownContent from '../components/MarkdownContent.astro';
import { marked } from 'marked';

const readmeUrl = 'https://raw.githubusercontent.com/framqui/framqui/refs/heads/main/README.md';
const profileMd = await fetch(readmeUrl).then((res) => res.text());
const htmlContent = marked.parse(profileMd, { gfm: true });
---

<BaseLayout active="inicio" title="Framqui" description="Sitio web de Andres Ramos, desarrollador de software. Escribimos sobre tecnología, desarrollo de software, inteligencia artificial, desarrollo de producto y más.">
  <MarkdownContent htmlContent={htmlContent} />
</BaseLayout>
