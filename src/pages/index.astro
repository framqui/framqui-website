---
import Header from '../components/Header.astro';
import ArticleHero from '../components/ArticleHero.astro';
import hero from '../data/hero.json';
import profileMd from '../content/profile.md?raw';
import { marked } from 'marked';
import '../styles/global.css';

const htmlContent = marked.parse(profileMd, { gfm: true });
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>framqui</title>
  </head>
  <body class="font-sans bg-bg text-gray-900 leading-relaxed antialiased">
    <Header active="inicio" />
    <main class="max-w-[800px] mx-auto px-8 sm:px-4">
      <ArticleHero title={hero.title} date={hero.date} />


      <div class="prose prose-base max-w-none pb-[8rem]" set:html={htmlContent} />
    </main>
  </body>
</html>
