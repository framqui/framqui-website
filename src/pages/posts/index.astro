---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { readMarkdown } from '../../lib/markdown.js';

const postsGlob = import.meta.glob('../../content/posts/*.md', { eager: true, query: '?raw', import: 'default' });
const articles = Object.entries(postsGlob).map(([path, raw]) => readMarkdown(path, raw)).sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<BaseLayout active="posts" title="Cerebro - Framqui" description="Artículos y escritos sobre desarrollo web, tecnología y programación.">
  <ArticleList
    title="Cerebro"
    articles={articles}
    basePath="/posts"
  />
</BaseLayout>
