---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';

const postsGlob = import.meta.glob('../../content/posts/*.md', { eager: true });
const articles = Object.entries(postsGlob).map(([path, mod]) => {
  const slug = path.split('/').pop()?.replace('.md', '') || '';
  return { slug, data: mod.frontmatter || {}, body: typeof mod.rawContent === 'function' ? mod.rawContent() : '' };
}).sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<BaseLayout active="posts" title="Escritos - Framqui" description="Artículos y escritos sobre desarrollo web, tecnología y programación.">
  <ArticleList
    title="Escritos"
    intro="Espacio para apuntes, aprendizajes y artículos sobre tecnología, inteligencia artificial, desarrollo de productos de software y temas relacionados."
    articles={articles}
    basePath="/posts"
  />
</BaseLayout>
