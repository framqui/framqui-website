---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import { readMarkdown } from '../../lib/markdown.js';
import { marked } from 'marked';

export const prerender = true;

export async function getStaticPaths() {
  const postsGlob = import.meta.glob('../../content/posts/*.md', { eager: true, query: '?raw', import: 'default' });

  return Object.entries(postsGlob).map(([filePath, raw]) => {
    const post = readMarkdown(filePath, raw);
    return {
      params: { slug: post.slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const htmlContent = marked.parse(post.body, { gfm: true });
---

<BaseLayout active="posts" title={`${post.data.title} - Escritos - Framqui`} description={post.data.description || 'Artículos sobre desarrollo web, tecnología y programación.'}>
  <ArticlePage htmlContent={htmlContent} backPath="/posts" showComments={true} />
</BaseLayout>
