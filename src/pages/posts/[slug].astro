---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import { marked } from 'marked';
import { posts } from '../../utils/content.js';

export async function getStaticPaths() {
  const allPosts = posts.loadAll();
  return allPosts.map((post) => ({
    params: { slug: post.slug },
    props: { slug: post.slug },
  }));
}

const { slug } = Astro.props;
const post = posts.loadBySlug(slug);
const htmlContent = marked.parse(post.body, { gfm: true });
---

<BaseLayout active="posts">
  <ArticlePage htmlContent={htmlContent} backPath="/posts" showComments={true} />
</BaseLayout>
