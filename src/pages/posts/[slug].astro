---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import { marked } from 'marked';

export const prerender = true;

export async function getStaticPaths() {
  const postsGlob = import.meta.glob('../../content/posts/*.md', { eager: true });
  const allPosts = Object.entries(postsGlob).map(([path, mod]) => {
    const slug = path.split('/').pop()?.replace('.md', '') || '';
    return { slug, data: mod.frontmatter || {} };
  });
  return allPosts.map((post) => ({
    params: { slug: post.slug },
    props: { slug: post.slug },
  }));
}

const { slug } = Astro.props;
const postsGlob = import.meta.glob('../../content/posts/*.md', { eager: true });
const key = Object.keys(postsGlob).find((k) => k.endsWith(`/${slug}.md`));
const mod = key ? postsGlob[key] : { frontmatter: {}, rawContent: () => '' };
const post = { slug, data: mod.frontmatter || {}, body: typeof mod.rawContent === 'function' ? mod.rawContent() : '' };
const htmlContent = marked.parse(post.body, { gfm: true });
---

<BaseLayout active="posts">
  <ArticlePage htmlContent={htmlContent} backPath="/posts" showComments={true} />
</BaseLayout>
