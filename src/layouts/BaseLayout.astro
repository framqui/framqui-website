---
import '../styles/global.css';
import MainProfileContent from "../components/MainProfileContent.astro";
import SecondaryDetailsSidebar from "../components/SecondaryDetailsSidebar.astro";
import Footer from "../components/Footer.astro";
import SidebarNav from "../components/SidebarNav.astro";
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Andres Ramos - Framqui</title>
</head>

<body class="bg-[var(--bg)] text-[var(--fg)] font-sans transition-colors duration-300">
<SidebarNav />
<div class="min-h-screen flex flex-col">
  <div class="min-w-0 flex-1 flex flex-col md:ml-[110px]">
    <main class="px-6 pt-4 md:pt-6 md:px-8 lg:flex lg:gap-12">
      <slot />
    </main>
    <Footer />
  </div>
</div>
</body>
</html>