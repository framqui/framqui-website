---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  active?: string;
  title?: string;
  description?: string;
}

const { active = 'inicio', title, description } = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';
const defaultTitle = 'Framqui';
const defaultDescription = 'Desarrollador web especializado en frontend, automatización y tecnología.';
const pageTitle = title || defaultTitle;
const pageDescription = description || defaultDescription;
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
  </head>
  <body class="font-sans bg-bg text-gray-900 leading-relaxed antialiased flex flex-col min-h-screen overflow-x-hidden">
    <Header active={active} />
    <main class="w-full max-w-[700px] mx-auto px-5 py-[5rem] flex-1 overflow-hidden min-h-[60vh]">
      <slot />
      <div class="text-right py-4 mt-8">
        <button
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="font-mono font-bold text-base text-text-muted no-underline cursor-pointer hover:text-blue hover:underline transition-colors"
        >
          subir →
        </button>
      </div>
    </main>
    <Footer />
  </body>
</html>
