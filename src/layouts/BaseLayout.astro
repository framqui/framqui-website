---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  active?: string;
  title?: string;
  description?: string;
}

const { active = 'inicio', title, description } = Astro.props;
const isHome = Astro.url.pathname === '/';

const configuredUrl = import.meta.env.PUBLIC_SITE_URL;
const siteUrl = configuredUrl && !String(configuredUrl).includes('localhost')
  ? String(configuredUrl).replace(/\/$/, '')
  : 'https://framqui.com';
const defaultTitle = 'Andres Ramos — Framqui';
const defaultDescription = 'Sitio web de Andres Ramos, desarrollador de software. Escribimos sobre tecnología, desarrollo de software, inteligencia artificial, desarrollo de producto y más.';
const pageTitle = title || defaultTitle;
const pageDescription = description || defaultDescription;
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const imageUrl = `${siteUrl}/favicon-192.png`;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Andres Ramos" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,500;1,500&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
    <meta property="og:site_name" content="Framqui" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Framqui" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Framqui',
      url: siteUrl,
      description: defaultDescription,
      author: {
        '@type': 'Person',
        name: 'Andres Ramos',
        url: siteUrl,
        sameAs: [
          'https://github.com/framqui',
          'https://www.linkedin.com/in/framqui/',
        ],
      },
    })} />
  </head>
  <body class="text-ink antialiased flex flex-col min-h-screen">
    <Header active={active} />
    <main class={isHome ? 'home-main' : 'page-main'}>
      {isHome ? <slot /> : <div class="page-inner"><slot /></div>}
    </main>
    <Footer />
    <script>
      document.querySelectorAll('form').forEach((form) => {
        form.noValidate = true;
        form.addEventListener('submit', (event) => {
          let message = form.querySelector('.form-error');
          if (!message) {
            message = document.createElement('p');
            message.className = 'notice notice-error form-error mt-3';
            form.append(message);
          }
          const field = form.querySelector(':invalid');
          if (!field) {
            message.hidden = true;
            return;
          }
          event.preventDefault();
          message.hidden = false;
          message.textContent = field.validationMessage;
          field.focus();
        });
      });
    </script>
  </body>
</html>
