---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/global.css';

interface Props {
  active?: string;
}

const { active = 'inicio' }: Props = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>framqui</title>
  </head>
  <body class="font-sans bg-bg text-gray-900 leading-relaxed antialiased flex flex-col min-h-screen overflow-x-hidden">
    <Header active={active} />
    <main class="max-w-[700px] mx-auto px-5 py-[5rem] flex-1 overflow-hidden">
      <slot />
      <ScrollToTop />
    </main>
    <Footer />
  </body>
</html>
